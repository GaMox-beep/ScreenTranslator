<Window x:Class="ScreenTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ScreenTranslator - Cài đặt" 
        Height="620" Width="640"
        MinHeight="560" MinWidth="540"
        WindowStartupLocation="CenterScreen"
        Background="#13131F"
        Foreground="#E2E8F0"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Card Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#1C1C2E"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#2D2D45"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <!-- Section Title Style -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#A5B4FC"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Label Style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <!-- Modern TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#25253D"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#3B3B5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern PasswordBox -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#25253D"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#3B3B5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#25253D"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#3B3B5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#6366F1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#4338CA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D45"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#3B3B5C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#25253D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="⚡" FontSize="24" Margin="0,0,8,0"/>
                <TextBlock Text="ScreenTranslator" FontSize="22" FontWeight="Bold" Foreground="#F8FAFC"/>
                <Border Background="#312E81" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="v1.0" FontSize="11" FontWeight="SemiBold" Foreground="#A5B4FC"/>
                </Border>
            </StackPanel>
            <TextBlock Text="Dịch màn hình nhanh chóng bằng Windows OCR và OpenRouter AI."
                       FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Main Form / Settings Cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel>
                
                <!-- Card 1: API & Model -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="🔑 Cấu hình OpenRouter API" Style="{StaticResource SectionTitle}"/>
                        
                        <TextBlock Text="API Key:" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="TxtApiKey" Grid.Column="0"/>
                            <TextBox x:Name="TxtApiKeyPlain" Grid.Column="0" Visibility="Collapsed"/>
                            <Button x:Name="BtnToggleKey" Content="👁" Grid.Column="1" Width="38" Height="36" 
                                    Margin="6,0,0,0" Style="{StaticResource SecondaryButton}" 
                                    Padding="0" Click="BtnToggleKey_Click" ToolTip="Ẩn / Hiện API Key"/>
                        </Grid>
                        
                        <TextBlock Text="Model Dịch thuật:" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="CmbModel" IsEditable="True">
                            <ComboBoxItem Content="google/gemini-2.0-flash-001" IsSelected="True"/>
                            <ComboBoxItem Content="google/gemini-2.0-flash-exp:free"/>
                            <ComboBoxItem Content="meta-llama/llama-3.3-70b-instruct:free"/>
                            <ComboBoxItem Content="deepseek/deepseek-chat"/>
                            <ComboBoxItem Content="openai/gpt-4o-mini"/>
                        </ComboBox>
                        <TextBlock Text="Gợi ý: Các model có hậu tố :free là miễn phí trên OpenRouter." 
                                   FontSize="11" Foreground="#64748B" Margin="2,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: Ngôn ngữ -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="🌐 Thiết lập Ngôn ngữ" Style="{StaticResource SectionTitle}"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ngôn ngữ nguồn:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbSourceLang">
                                    <ComboBoxItem Content="Auto Detect" IsSelected="True"/>
                                    <ComboBoxItem Content="English"/>
                                    <ComboBoxItem Content="Japanese"/>
                                    <ComboBoxItem Content="Chinese"/>
                                    <ComboBoxItem Content="Korean"/>
                                    <ComboBoxItem Content="French"/>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Text="➔" Grid.Column="1" FontSize="18" Foreground="#64748B"
                                       VerticalAlignment="Center" Margin="14,20,14,0"/>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Ngôn ngữ đích:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbTargetLang">
                                    <ComboBoxItem Content="Vietnamese" IsSelected="True"/>
                                    <ComboBoxItem Content="English"/>
                                    <ComboBoxItem Content="Japanese"/>
                                    <ComboBoxItem Content="Chinese"/>
                                    <ComboBoxItem Content="French"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card 3: Phím tắt -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="⌨️ Phím tắt kích hoạt (Global Shortcut)" Style="{StaticResource SectionTitle}"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Phím bổ trợ:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbModifier">
                                    <ComboBoxItem Content="Alt" IsSelected="True"/>
                                    <ComboBoxItem Content="Ctrl"/>
                                    <ComboBoxItem Content="Shift"/>
                                    <ComboBoxItem Content="Ctrl + Alt"/>
                                    <ComboBoxItem Content="Ctrl + Shift"/>
                                </ComboBox>
                            </StackPanel>

                            <TextBlock Text="+" Grid.Column="1" FontSize="16" Foreground="#64748B"
                                       VerticalAlignment="Center" Margin="14,20,14,0"/>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Phím bấm:" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="CmbKey">
                                    <ComboBoxItem Content="Q" IsSelected="True"/>
                                    <ComboBoxItem Content="S"/>
                                    <ComboBoxItem Content="T"/>
                                    <ComboBoxItem Content="D"/>
                                    <ComboBoxItem Content="F"/>
                                    <ComboBoxItem Content="Z"/>
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="` (Tilde)"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer / Action bar -->
        <Border Grid.Row="2" BorderBrush="#2D2D45" BorderThickness="0,1,0,0" Padding="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status Message -->
                <TextBlock x:Name="TxtStatus" Grid.Column="0" VerticalAlignment="Center" 
                           FontSize="12" Foreground="#10B981" Text="● Sẵn sàng"/>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnTestCapture" Content="🔍 Chụp thử" 
                            Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                            Click="BtnTestCapture_Click"/>
                    <Button x:Name="BtnSave" Content="💾 Lưu Cài Đặt" 
                            Style="{StaticResource PrimaryButton}" 
                            Click="BtnSave_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
