<Window x:Class="ScreenTranslator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenTranslator - Cài đặt" 
        Width="460" Height="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Nhóm 1: API OpenRouter -->
        <GroupBox Grid.Row="0" Header="Cấu hình OpenRouter API" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="API Key:" VerticalAlignment="Center"/>
                <PasswordBox x:Name="TxtApiKey" Grid.Row="0" Grid.Column="1" Height="26" VerticalContentAlignment="Center"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Model:" VerticalAlignment="Center" Margin="0,8,0,0"/>
                <ComboBox x:Name="CmbModel" Grid.Row="1" Grid.Column="1" Height="26" IsEditable="True" Margin="0,8,0,0">
                    <ComboBoxItem Content="google/gemini-2.0-flash-001" IsSelected="True"/>
                    <ComboBoxItem Content="google/gemini-2.0-flash-exp:free"/>
                    <ComboBoxItem Content="meta-llama/llama-3.3-70b-instruct:free"/>
                    <ComboBoxItem Content="deepseek/deepseek-chat"/>
                </ComboBox>
            </Grid>
        </GroupBox>

        <!-- Nhóm 2: Ngôn ngữ -->
        <GroupBox Grid.Row="1" Header="Ngôn ngữ" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Label Content="Nguồn:" Padding="0,0,0,3"/>
                    <ComboBox x:Name="CmbSourceLang" Height="26">
                        <ComboBoxItem Content="Auto Detect" IsSelected="True"/>
                        <ComboBoxItem Content="English"/>
                        <ComboBoxItem Content="Japanese"/>
                        <ComboBoxItem Content="Chinese"/>
                        <ComboBoxItem Content="Korean"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="➔" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5"/>

                <StackPanel Grid.Column="2">
                    <Label Content="Đích:" Padding="0,0,0,3"/>
                    <ComboBox x:Name="CmbTargetLang" Height="26">
                        <ComboBoxItem Content="Vietnamese" IsSelected="True"/>
                        <ComboBoxItem Content="English"/>
                        <ComboBoxItem Content="Japanese"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Nhóm 3: Phím tắt -->
        <GroupBox Grid.Row="2" Header="Phím tắt quét màn hình" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <ComboBox x:Name="CmbModifier" Grid.Column="0" Height="26">
                    <ComboBoxItem Content="Alt" IsSelected="True"/>
                    <ComboBoxItem Content="Ctrl"/>
                    <ComboBoxItem Content="Shift"/>
                    <ComboBoxItem Content="Ctrl + Alt"/>
                </ComboBox>

                <TextBlock Grid.Column="1" Text="+" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <ComboBox x:Name="CmbKey" Grid.Column="2" Height="26">
                    <ComboBoxItem Content="Q" IsSelected="True"/>
                    <ComboBoxItem Content="S"/>
                    <ComboBoxItem Content="T"/>
                    <ComboBoxItem Content="D"/>
                    <ComboBoxItem Content="` (Tilde)"/>
                </ComboBox>
            </Grid>
        </GroupBox>

        <!-- Nút thao tác & Trạng thái -->
        <DockPanel Grid.Row="4" LastChildFill="False">
            <TextBlock x:Name="TxtStatus" Text="Sẵn sàng" VerticalAlignment="Center" Foreground="#107C41" DockPanel.Dock="Left"/>

            <Button x:Name="BtnSave" Content="Lưu Cài Đặt" Width="100" Height="28" 
                    DockPanel.Dock="Right" Click="BtnSave_Click"/>
            <Button x:Name="BtnTestCapture" Content="Chụp Thử" Width="90" Height="28" 
                    Margin="0,0,10,0" DockPanel.Dock="Right" Click="BtnTestCapture_Click"/>
        </DockPanel>
    </Grid>
</Window>
