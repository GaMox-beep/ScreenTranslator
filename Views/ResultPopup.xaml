<Window x:Class="ScreenTranslator.Views.ResultPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ScreenTranslator.ViewModels"
        Title="ScreenTranslator - Kết quả"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MinWidth="300"
        MaxWidth="750"
        MinHeight="120"
        MaxHeight="550"
        ResizeMode="CanResizeWithGrip">

    <Window.DataContext>
        <vm:ResultViewModel />
    </Window.DataContext>

    <Border Background="#1E222D"
            BorderBrush="#384152"
            BorderThickness="1"
            CornerRadius="6"
            Padding="12"
            MinWidth="300"
            MaxWidth="750">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Thanh điều khiển trên cùng (Có thể kéo để di chuyển) -->
            <Grid Grid.Row="0" Margin="0,0,0,8" Background="Transparent" MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Bản dịch"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#9CA3AF"
                           VerticalAlignment="Center" />

                <!-- Nút thao tác dạng text thuần túy -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnCopy"
                            Content="{Binding CopyButtonText}"
                            Click="BtnCopy_Click"
                            Cursor="Hand"
                            Background="#2A303C"
                            Foreground="#E5E7EB"
                            BorderBrush="#4B5563"
                            BorderThickness="1"
                            Padding="8,2"
                            FontSize="11"
                            Margin="0,0,6,0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanCopy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Content="Đóng"
                            Click="BtnClose_Click"
                            Cursor="Hand"
                            Background="Transparent"
                            Foreground="#9CA3AF"
                            BorderThickness="0"
                            Padding="6,2"
                            FontSize="11" />
                </StackPanel>
            </Grid>

            <!-- Nội dung dịch / thông báo trạng thái -->
            <ScrollViewer x:Name="ContentScrollViewer"
                          Grid.Row="1"
                          MaxHeight="480"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <TextBox x:Name="TxtResult"
                         Text="{Binding DisplayText, Mode=OneWay}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="13"
                         FontFamily="Segoe UI"
                         Padding="0"
                         PreviewMouseWheel="TxtResult_PreviewMouseWheel">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="#F3F4F6" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Foreground" Value="#9CA3AF" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Foreground" Value="#F87171" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
